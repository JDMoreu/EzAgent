# Copia este archivo a .env y rellena la clave de tu proveedor.
# También puedes configurar todo desde el menú del notch (LLM · API).
# Cualquier endpoint compatible con OpenAI sirve. Ver docs/llm-providers.md.

# ---------- LLM: proveedor y modelo ----------
# opencode | openai | groq | anthropic | gemini | openrouter | custom
LLM_PROVIDER=opencode
OPENCODE_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Para Claude con clave personal/sin workspace:
# ANTHROPIC_WORKSPACE_ID=

# Overrides genéricos. Si no los pones se usan los del proveedor.
# LLM_MODEL=deepseek-v4.1-flash
# LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
# LLM_API_KEY=

# Archivo opcional con perfiles por proveedor. El menú escribe aquí los
# perfiles que guardas desde LLM · API.
# EZ_LLM_CONFIG=C:/Users/tu_usuario/AppData/Roaming/EzAgent/llm.json

# ---------- STT: whisper.cpp server ----------
# EzAgent arranca whisper-server en un puerto local libre y configura la URL
# solo. WHISPER_URL solo hace falta para conectar con un servidor externo.
# whisper.cpp:              http://127.0.0.1:8088/inference
# compatible OpenAI:        http://127.0.0.1:8088/v1/audio/transcriptions
WHISPER_URL=http://127.0.0.1:8088/inference
# auto | vulkan | cpu
# WHISPER_ENGINE=auto

# ---------- Audio ----------
# El micrófono se elige en el menú del notch (AUDIO · Micrófono).
# EZ_OUTPUT_DEVICE_INDEX=3
